{
  "about": "gyroflow.conf (the gyroflow plugin's script-opts) as the app's defaults a render is made with: the gyroflow plugin's defaults_bundle, published as user-data/gyroflow/defaults with its edges, edges_blur and temporal_denoise (tests/gyroflow_conf_test.lua, over a fake mpv whose read_options reads the conf as mpv's player/lua/options.lua does: no spaces trimmed, # only at a line's start, a boolean only yes or no, a number or the default), and the Library's renders::defaults_of (cargo test in library/), which must read it the same way: the Library's recipe and hash say what the player renders. conf: the file's lines. No Gyroflow preset beside the plugin: preset_horizon no, horizon_lock project is no. A case added here is checked on both sides.",
  "cases": [
    { "name": "no gyroflow.conf: the plugin's defaults", "conf": [],
      "want": { "defaults": { "view": "normal", "level": "medium", "horizon_lock": "no", "chromatic": true, "aspect": "original", "orientation": "as-is",
                              "projection": "linear", "lens": "corrected", "denoise": true, "denoise_strong": false, "preset_horizon": "no", "underwater": "auto" },
                "edges": "sphere", "edges_blur": 2, "temporal_denoise": "full" } },
    { "name": "every setting changed", "conf": ["view=wide", "level=strong", "horizon_lock=yes", "chromatic=no", "projection=stereographic", "lens=as-recorded",
                                              "still=no", "denoise_strong=yes", "edges=off", "edges_blur=5", "temporal_denoise=light"],
      "want": { "defaults": { "view": "wide", "level": "strong", "horizon_lock": "yes", "chromatic": false, "aspect": "original", "orientation": "as-is",
                              "projection": "stereographic", "lens": "as-recorded", "denoise": false, "denoise_strong": true, "preset_horizon": "no", "underwater": "auto" },
                "edges": "off", "edges_blur": 5, "temporal_denoise": "light" } },
    { "name": "values it doesn't know: the defaults'", "conf": ["view=sideways", "level=extreme", "horizon_lock=maybe", "projection=fisheye", "lens=bent",
                                                                 "edges=black", "edges_blur=lots", "temporal_denoise=max"],
      "want": { "defaults": { "view": "normal", "level": "medium", "horizon_lock": "no", "chromatic": true, "aspect": "original", "orientation": "as-is",
                              "projection": "linear", "lens": "corrected", "denoise": true, "denoise_strong": false, "preset_horizon": "no", "underwater": "auto" },
                "edges": "sphere", "edges_blur": 2, "temporal_denoise": "full" } },
    { "name": "a boolean is yes or no (true and false aren't read)", "conf": ["chromatic=false", "still=false", "denoise_strong=true"],
      "want": { "defaults": { "view": "normal", "level": "medium", "horizon_lock": "no", "chromatic": true, "aspect": "original", "orientation": "as-is",
                              "projection": "linear", "lens": "corrected", "denoise": true, "denoise_strong": false, "preset_horizon": "no", "underwater": "auto" },
                "edges": "sphere", "edges_blur": 2, "temporal_denoise": "full" } },
    { "name": "spaces aren't trimmed, # only at the start: none of these is read", "conf": ["level = strong", "view= wide", "edges =off", " lens=as-recorded",
                                                                                          "#chromatic=no", "  # still=no"],
      "want": { "defaults": { "view": "normal", "level": "medium", "horizon_lock": "no", "chromatic": true, "aspect": "original", "orientation": "as-is",
                              "projection": "linear", "lens": "corrected", "denoise": true, "denoise_strong": false, "preset_horizon": "no", "underwater": "auto" },
                "edges": "sphere", "edges_blur": 2, "temporal_denoise": "full" } },
    { "name": "the horizon as the preset says (none: not locked)", "conf": ["horizon_lock=project", "level=weak"],
      "want": { "defaults": { "view": "normal", "level": "weak", "horizon_lock": "no", "chromatic": true, "aspect": "original", "orientation": "as-is",
                              "projection": "linear", "lens": "corrected", "denoise": true, "denoise_strong": false, "preset_horizon": "no", "underwater": "auto" },
                "edges": "sphere", "edges_blur": 2, "temporal_denoise": "full" } },
    { "name": "an aspect with its orientation", "conf": ["aspect=16:9", "orientation=portrait"],
      "want": { "defaults": { "view": "normal", "level": "medium", "horizon_lock": "no", "chromatic": true, "aspect": "16:9", "orientation": "portrait",
                              "projection": "linear", "lens": "corrected", "denoise": true, "denoise_strong": false, "preset_horizon": "no", "underwater": "auto" },
                "edges": "sphere", "edges_blur": 2, "temporal_denoise": "full" } },
    { "name": "an aspect alone", "conf": ["aspect=4:3"],
      "want": { "defaults": { "view": "normal", "level": "medium", "horizon_lock": "no", "chromatic": true, "aspect": "4:3", "orientation": "as-is",
                              "projection": "linear", "lens": "corrected", "denoise": true, "denoise_strong": false, "preset_horizon": "no", "underwater": "auto" },
                "edges": "sphere", "edges_blur": 2, "temporal_denoise": "full" } },
    { "name": "an old portrait aspect: 16:9 portrait", "conf": ["aspect=9:16"],
      "want": { "defaults": { "view": "normal", "level": "medium", "horizon_lock": "no", "chromatic": true, "aspect": "16:9", "orientation": "portrait",
                              "projection": "linear", "lens": "corrected", "denoise": true, "denoise_strong": false, "preset_horizon": "no", "underwater": "auto" },
                "edges": "sphere", "edges_blur": 2, "temporal_denoise": "full" } },
    { "name": "the other edge fill and a smaller blur", "conf": ["edges=smooth", "edges_blur=0.5", "temporal_denoise=off"],
      "want": { "defaults": { "view": "normal", "level": "medium", "horizon_lock": "no", "chromatic": true, "aspect": "original", "orientation": "as-is",
                              "projection": "linear", "lens": "corrected", "denoise": true, "denoise_strong": false, "preset_horizon": "no", "underwater": "auto" },
                "edges": "smooth", "edges_blur": 0.5, "temporal_denoise": "off" } },
    { "name": "#317: the lens under water by default", "conf": ["underwater=yes"],
      "want": { "defaults": { "view": "normal", "level": "medium", "horizon_lock": "no", "chromatic": true, "aspect": "original", "orientation": "as-is",
                              "projection": "linear", "lens": "corrected", "denoise": true, "denoise_strong": false, "preset_horizon": "no", "underwater": "yes" },
                "edges": "sphere", "edges_blur": 2, "temporal_denoise": "full" } },
    { "name": "#317: as the project says isn't a default for a source: auto", "conf": ["underwater=project"],
      "want": { "defaults": { "view": "normal", "level": "medium", "horizon_lock": "no", "chromatic": true, "aspect": "original", "orientation": "as-is",
                              "projection": "linear", "lens": "corrected", "denoise": true, "denoise_strong": false, "preset_horizon": "no", "underwater": "auto" },
                "edges": "sphere", "edges_blur": 2, "temporal_denoise": "full" } }
  ]
}
