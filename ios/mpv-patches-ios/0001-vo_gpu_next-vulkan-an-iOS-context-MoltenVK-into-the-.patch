From 30b59bfa15e4c2a812edb2fb91c3aa8bfe8ab6be Mon Sep 17 00:00:00 2001
From: ActionFootagePlayer <build@localhost>
Date: Mon, 9 Nov 2026 16:27:37 +0100
Subject: [PATCH] vo_gpu_next: vulkan: an iOS context, MoltenVK into the app's
 CAMetalLayer (--wid)

---
 meson.build                    |   7 ++
 video/out/gpu/context.c        |   4 +
 video/out/vulkan/context_ios.m | 136 +++++++++++++++++++++++++++++++++
 3 files changed, 147 insertions(+)
 create mode 100644 video/out/vulkan/context_ios.m

diff --git a/meson.build b/meson.build
index 103a50808..9395ab011 100644
--- a/meson.build
+++ b/meson.build
@@ -1359,6 +1359,13 @@ if features['vulkan']
                      'video/filter/vf_gpu_vulkan.c')
 endif
 
+# iOS: Vulkan through MoltenVK into the embedding app's CAMetalLayer (--wid)
+features += {'ios-vulkan': features['vulkan'] and darwin and not features['cocoa']}
+if features['ios-vulkan']
+    sources += files('video/out/vulkan/context_ios.m')
+    dependencies += dependency('appleframeworks', modules: ['QuartzCore', 'Metal'])
+endif
+
 if features['vulkan'] and features['android']
     sources += files('video/out/vulkan/context_android.c')
 endif
diff --git a/video/out/gpu/context.c b/video/out/gpu/context.c
index 60c0641a7..307c75229 100644
--- a/video/out/gpu/context.c
+++ b/video/out/gpu/context.c
@@ -50,6 +50,7 @@ extern const struct ra_ctx_fns ra_ctx_vulkan_xlib;
 extern const struct ra_ctx_fns ra_ctx_vulkan_android;
 extern const struct ra_ctx_fns ra_ctx_vulkan_display;
 extern const struct ra_ctx_fns ra_ctx_vulkan_mac;
+extern const struct ra_ctx_fns ra_ctx_vulkan_ios;
 
 /* Direct3D 11 */
 extern const struct ra_ctx_fns ra_ctx_d3d11;
@@ -96,6 +97,9 @@ static const struct ra_ctx_fns *const contexts[] = {
 #if HAVE_COCOA && HAVE_SWIFT
     &ra_ctx_vulkan_mac,
 #endif
+#if HAVE_IOS_VULKAN
+    &ra_ctx_vulkan_ios,
+#endif
 #endif
 
 // OpenGL contexts:
diff --git a/video/out/vulkan/context_ios.m b/video/out/vulkan/context_ios.m
new file mode 100644
index 000000000..ee60111b8
--- /dev/null
+++ b/video/out/vulkan/context_ios.m
@@ -0,0 +1,136 @@
+/*
