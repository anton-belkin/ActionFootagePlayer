+ */
+
+// Vulkan (MoltenVK) on iOS: libmpv renders into the CAMetalLayer the embedding app hands over with --wid (a
+// CAMetalLayer pointer). The app sizes the layer (its drawableSize); a change is taken up at the next event check.
+
+#import <QuartzCore/CAMetalLayer.h>
+#include <vulkan/vulkan.h>
+#include <vulkan/vulkan_metal.h>
+
+#include "video/out/gpu/context.h"
+#include "video/out/vo.h"
+#include "common.h"
+#include "context.h"
+#include "utils.h"
+
+struct priv {
+    struct mpvk_ctx vk;
+    CAMetalLayer *layer;
+    int w, h;
+};
+
+static bool layer_size(struct ra_ctx *ctx, int *w, int *h)
+{
+    struct priv *p = ctx->priv;
+    CGSize s = p->layer.drawableSize;
+    if (s.width < 1 || s.height < 1) {
+        CGFloat scale = p->layer.contentsScale > 0 ? p->layer.contentsScale : 1;
+        s = CGSizeMake(p->layer.bounds.size.width * scale, p->layer.bounds.size.height * scale);
+    }
+    *w = (int)s.width;
+    *h = (int)s.height;
+    return *w > 0 && *h > 0;
+}
+
+static void ios_uninit(struct ra_ctx *ctx)
+{
+    struct priv *p = ctx->priv;
+    ra_vk_ctx_uninit(ctx);
+    mpvk_uninit(&p->vk);
+    p->layer = nil;
+}
+
+static bool ios_init(struct ra_ctx *ctx)
+{
+    struct priv *p = ctx->priv = talloc_zero(ctx, struct priv);
+    struct mpvk_ctx *vk = &p->vk;
+    int msgl = ctx->opts.probing ? MSGL_V : MSGL_ERR;
+
+    int64_t wid = ctx->vo->opts->WinID;
+    if (wid == 0 || wid == -1) {
+        MP_MSG(ctx, msgl, "iOS: --wid must be a CAMetalLayer\n");
+        goto fail;
+    }
+    p->layer = (__bridge CAMetalLayer *)(void *)(intptr_t)wid;
+
+    if (!mpvk_init(vk, ctx, VK_EXT_METAL_SURFACE_EXTENSION_NAME))
+        goto fail;
+
+    VkMetalSurfaceCreateInfoEXT info = {
+        .sType = VK_STRUCTURE_TYPE_METAL_SURFACE_CREATE_INFO_EXT,
+        .pLayer = (__bridge const CAMetalLayer *)p->layer,
+    };
+
+    struct ra_ctx_params params = {0};
+
+    VkInstance inst = vk->vkinst->instance;
+    VkResult res = vkCreateMetalSurfaceEXT(inst, &info, NULL, &vk->surface);
+    if (res != VK_SUCCESS) {
+        MP_MSG(ctx, msgl, "Failed creating the Metal surface\n");
+        goto fail;
+    }
+
+    if (!ra_vk_ctx_init(ctx, vk, params, VK_PRESENT_MODE_FIFO_KHR))
+        goto fail;
+
+    return true;
+fail:
+    ios_uninit(ctx);
+    return false;
+}
+
+static bool ios_reconfig(struct ra_ctx *ctx)
+{
+    struct priv *p = ctx->priv;
+    int w, h;
+    if (!layer_size(ctx, &w, &h))
+        return false;
+    p->w = w;
+    p->h = h;
+    ctx->vo->dwidth = w;
+    ctx->vo->dheight = h;
+    return ra_vk_ctx_resize(ctx, w, h);
+}
+
+static int ios_control(struct ra_ctx *ctx, int *events, int request, void *arg)
+{
+    struct priv *p = ctx->priv;
+    if (request == VOCTRL_CHECK_EVENTS) {
+        int w, h;
+        if (layer_size(ctx, &w, &h) && (w != p->w || h != p->h)) {
+            p->w = w;
+            p->h = h;
+            ctx->vo->dwidth = w;
+            ctx->vo->dheight = h;
+            ra_vk_ctx_resize(ctx, w, h);
+            *events |= VO_EVENT_RESIZE;
+        }
+        return VO_TRUE;
+    }
+    return VO_NOTIMPL;
+}
+
+const struct ra_ctx_fns ra_ctx_vulkan_ios = {
+    .type           = "vulkan",
+    .name           = "iosvk",
+    .description    = "iOS/Vulkan (MoltenVK, --wid a CAMetalLayer)",
+    .reconfig       = ios_reconfig,
+    .control        = ios_control,
+    .init           = ios_init,
+    .uninit         = ios_uninit,
+};
