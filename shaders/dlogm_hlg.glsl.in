// DJI D-Log M -> Rec.2100 HLG (1000-nit) at HOOK MAIN, mpv-standalone only.
//
// The LUT's output is HLG-encoded BT.2020. For mpv to pass it through unchanged, the dlogm plugin tags the video
// as HLG/BT.2020 (vf=format:gamma=hlg:primaries=bt.2020) and sets the same as the target (target-trc=hlg,
// target-prim=bt.2020, target-peak=1000): mpv's color pipeline then runs an HLG -> HLG identity. Tagged as the
// file's BT.709, mpv would linearize the HLG output as BT.709 and encode it again, a double transform that
// destroys colors. target-colorspace-hint=yes switches the display to HDR (vo=gpu-next).
//
// Not at HOOK OUTPUT, re-sampling the source through BIND MAIN, as it was up to 0.5.0: when mpv redraws a paused
// frame, libplacebo outputs the frame it cached at MAIN's stage, without MAIN to bind, and skips the shader.
// The picture went flat grey on pause.

//!TEXTURE HLGLUT
//!SIZE @LUT_SIZE@ @LUT_SIZE@ @LUT_SIZE@
//!FORMAT rgba16
//!FILTER LINEAR
//!BORDER CLAMP
@LUT_DATA@

//!HOOK MAIN
//!BIND HOOKED
//!BIND HLGLUT
//!DESC DJI D-Log M -> Rec.2100 HLG

vec4 hook() {
    vec4 c = HOOKED_tex(HOOKED_pos);
    const float N = @LUT_SIZE@.0;
    vec3 lut_coord = clamp(c.rgb, 0.0, 1.0) * ((N - 1.0) / N) + (0.5 / N);
    return vec4(texture(HLGLUT, lut_coord).rgb, c.a);
}
