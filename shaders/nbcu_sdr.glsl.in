// HDR (Rec.2100 HLG or PQ) -> Rec.709 SDR at HOOK MAIN, by NBCUniversal's conversion LUTs: nbcu_hlg2sdr.glsl and
// nbcu_pq2sdr.glsl, baked from luts/3-NBCU_HLG2SDR_DL_v1.2.cube and luts/5-NBCU_PQ2SDR_DL_v1.2.cube. The dlogm
// plugin's NBCU look: after a log curve's HLG shader (log_hlg.glsl.in), or alone on video tagged HLG or PQ, with the
// video then tagged BT.709 so mpv shows the result as SDR.
//
// NBCU's are Type III LUTs, full range processing for narrow range signals: the signal's 0..1 is (64 + 876 x) / 1023
// of the LUT's domain, in and out, as NBCU's own ffmpeg recipe does it. Their highlight knee needs tetrahedral
// interpolation, so it's done here from the texels rather than by the hardware's trilinear filter; NBCU's
// highlights above 100 % are clipped, as on a display.

//!TEXTURE NBCULUT
//!SIZE @LUT_SIZE@ @LUT_SIZE@ @LUT_SIZE@
//!FORMAT rgba16
//!FILTER NEAREST
//!BORDER CLAMP
@LUT_DATA@

//!HOOK MAIN
//!BIND HOOKED
//!BIND NBCULUT
//!DESC HDR -> SDR (NBCU)

vec3 at(ivec3 p) {
    return texelFetch(NBCULUT, p, 0).rgb;
}

vec4 hook() {
    vec4 c = HOOKED_tex(HOOKED_pos);
    const float N = @LUT_SIZE@.0;
    const float LO = 64.0 / 1023.0;
    const float SPAN = 876.0 / 1023.0;
    vec3 p = (clamp(c.rgb, 0.0, 1.0) * SPAN + LO) * (N - 1.0);
    ivec3 i = ivec3(min(floor(p), vec3(N - 2.0)));
    vec3 f = p - vec3(i);
    // The tetrahedron the point is in: from the cell's 000 corner to its 111, one axis at a time, the largest
    // fraction first
    vec3 c000 = at(i);
    vec3 c111 = at(i + ivec3(1));
    vec3 o;
    if (f.r >= f.g) {
        if (f.g >= f.b) {
            vec3 a = at(i + ivec3(1, 0, 0)), b = at(i + ivec3(1, 1, 0));
            o = c000 + f.r * (a - c000) + f.g * (b - a) + f.b * (c111 - b);
        } else if (f.r >= f.b) {
            vec3 a = at(i + ivec3(1, 0, 0)), b = at(i + ivec3(1, 0, 1));
            o = c000 + f.r * (a - c000) + f.b * (b - a) + f.g * (c111 - b);
        } else {
            vec3 a = at(i + ivec3(0, 0, 1)), b = at(i + ivec3(1, 0, 1));
            o = c000 + f.b * (a - c000) + f.r * (b - a) + f.g * (c111 - b);
        }
    } else {
        if (f.b >= f.g) {
            vec3 a = at(i + ivec3(0, 0, 1)), b = at(i + ivec3(0, 1, 1));
            o = c000 + f.b * (a - c000) + f.g * (b - a) + f.r * (c111 - b);
        } else if (f.b >= f.r) {
            vec3 a = at(i + ivec3(0, 1, 0)), b = at(i + ivec3(0, 1, 1));
            o = c000 + f.g * (a - c000) + f.b * (b - a) + f.r * (c111 - b);
        } else {
            vec3 a = at(i + ivec3(0, 1, 0)), b = at(i + ivec3(1, 1, 0));
            o = c000 + f.g * (a - c000) + f.r * (b - a) + f.b * (c111 - b);
        }
    }
    return vec4(clamp((o - LO) / SPAN, 0.0, 1.0), c.a);
}
