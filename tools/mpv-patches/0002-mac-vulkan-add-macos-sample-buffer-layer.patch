+
+// Presents vo_gpu_next's frames through an AVSampleBufferDisplayLayer: rendered into IOSurface-backed CVPixelBuffers
+// (10-bit 4:2:0, the format macOS's video path takes, Dolby Vision display management included) and enqueued with
+// their color tags, so macOS shows them as its own video player would.
+struct mac_sample_buffer *mac_sample_buffer_create(struct mp_log *log, void *layer);
+void mac_sample_buffer_destroy(struct mac_sample_buffer **sb, pl_gpu gpu);
+
+bool mac_sample_buffer_start_frame(struct mac_sample_buffer *sb, pl_gpu gpu, int w, int h,
+                                   const struct pl_color_space *hint, struct ra_ext_frame *out);
+void mac_sample_buffer_submit(struct mac_sample_buffer *sb, pl_gpu gpu, struct ra_ext_frame *frame,
+                              const struct ra_ext_submit *info);
+
+// Drops the frame the layer shows, when the swapchain takes over again
+void mac_sample_buffer_flush(struct mac_sample_buffer *sb);
