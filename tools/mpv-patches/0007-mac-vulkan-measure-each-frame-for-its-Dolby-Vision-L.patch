+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with mpv.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+
+// A Dolby Vision RPU (the NAL payload from its 0x19 prefix on, emulation prevention bytes in it, as dovi_tool
+// writes them and libavcodec exports them) with its L1 replaced: the frame's min, average and max of max(R,G,B) in
+// 12-bit PQ codes, clamped as dovi_tool's generator clamps them (min at most 12, max at least 2081, the average from
+// 1229 to max - 1), and its CRC32 written anew.
+//
+// Writes the new RPU to `out` (`out_size` bytes, at least size + size / 2 + 8) and returns its length, or 0 when the
+// RPU has no L1 block (the first CM v2.9 extension block, where dovi_tool's generator puts it) or doesn't parse.
+size_t mp_dovi_rpu_set_l1(const uint8_t *rpu, size_t size, int min_pq, int avg_pq, int max_pq,
+                          uint8_t *out, size_t out_size);
diff --git a/video/out/mac/sample_buffer.h b/video/out/mac/sample_buffer.h
index ee0f788c5..4fa713e68 100644
--- a/video/out/mac/sample_buffer.h
+++ b/video/out/mac/sample_buffer.h
@@ -42,6 +42,11 @@ void mac_sample_buffer_submit(struct mac_sample_buffer *sb, pl_gpu gpu, struct r
 // Read again when the path changes.
 void mac_sample_buffer_set_rpu_file(struct mac_sample_buffer *sb, const char *path);
 
+// Measure each frame (min, average and max of max(R,G,B) in PQ, inside the video) and write that as the L1 of the
+// RPU --macos-dovi-rpu-file gives it: the system's display management then maps each frame for what's in it. Frames
+// with their own RPU keep it as it is.
+void mac_sample_buffer_set_live_l1(struct mac_sample_buffer *sb, bool live);
+
 // Whether creating or importing the buffers failed: the swapchain should take over
 bool mac_sample_buffer_failed(struct mac_sample_buffer *sb);
 
diff --git a/video/out/mac/sample_buffer.m b/video/out/mac/sample_buffer.m
index eacb4109b..2f9bd113f 100644
--- a/video/out/mac/sample_buffer.m
+++ b/video/out/mac/sample_buffer.m
@@ -31,8 +31,78 @@
 #include "mpv_talloc.h"
 #include "video/out/gpu/context.h"
 
+#include "dovi_l1.h"
 #include "sample_buffer.h"
 
+// --macos-dovi-live-l1: each frame's min, average and max of max(R,G,B) in 12-bit PQ codes, measured on the buffer
+// the layer gets (what macOS's display management sees), inside the video's rectangle. HLG is taken to display light
+// for 1000 nits by BT.2100's OOTF (system gamma 1.2), as the profile 8.4 RPU maps it to PQ; PQ is measured as it is.
+// Each 16x16 threadgroup writes its part; the CPU adds them up.
+static const char *const l1_kernel =
+    "#include <metal_stdlib>\n"
+    "using namespace metal;\n"
+    "struct l1_params { uint x0, y0, x1, y1, hlg; };\n"
+    "struct l1_part { float sum; uint count; float lo; float hi; };\n"
+    "static float hlg_scene(float e) {\n"
+    "    e = clamp(e, 0.0f, 1.0f);\n"
+    "    return e <= 0.5f ? e * e / 3.0f : (exp((e - 0.55991073f) / 0.17883277f) + 0.28466892f) / 12.0f;\n"
+    "}\n"
+    "static float pq(float nits) {\n"
+    "    float y = pow(clamp(nits / 10000.0f, 0.0f, 1.0f), 0.1593017578125f);\n"
+    "    return pow((0.8359375f + 18.8515625f * y) / (1.0f + 18.6875f * y), 78.84375f);\n"
+    "}\n"
+    "kernel void l1(texture2d<float, access::read> luma [[texture(0)]],\n"
+    "               texture2d<float, access::read> chroma [[texture(1)]],\n"
+    "               constant l1_params &p [[buffer(0)]],\n"
+    "               device l1_part *out [[buffer(1)]],\n"
+    "               uint2 gid [[thread_position_in_grid]],\n"
+    "               uint2 group [[threadgroup_position_in_grid]],\n"
+    "               uint2 groups [[threadgroups_per_grid]],\n"
+    "               uint tid [[thread_index_in_threadgroup]],\n"
+    "               uint sg [[simdgroup_index_in_threadgroup]],\n"
+    "               uint lane [[thread_index_in_simdgroup]],\n"
+    "               uint sgs [[simdgroups_per_threadgroup]])\n"
+    "{\n"
+    "    threadgroup float t_sum[32], t_lo[32], t_hi[32];\n"
+    "    threadgroup uint t_count[32];\n"
+    "    uint2 pos = gid + uint2(p.x0, p.y0);\n"
+    "    bool in = pos.x < p.x1 && pos.y < p.y1;\n"
+    "    float v = 0.0f;\n"
+    "    if (in) {\n"
+    "        // 10-bit limited range BT.2020, MSB-aligned in 16 bits\n"
+    "        float y = luma.read(pos).r * (65535.0f / 64.0f);\n"
+    "        float2 c = chroma.read(pos / 2).rg * (65535.0f / 64.0f);\n"
+    "        float Y = (y - 64.0f) / 876.0f, cb = (c.x - 512.0f) / 896.0f, cr = (c.y - 512.0f) / 896.0f;\n"
+    "        float R = Y + 1.4746f * cr, B = Y + 1.8814f * cb;\n"
+    "        float3 e = clamp(float3(R, (Y - 0.2627f * R - 0.0593f * B) / 0.6780f, B), 0.0f, 1.0f);\n"
+    "        if (p.hlg) {\n"
+    "            float3 s = float3(hlg_scene(e.r), hlg_scene(e.g), hlg_scene(e.b));\n"
+    "            float ys = dot(s, float3(0.2627f, 0.6780f, 0.0593f));\n"
+    "            float nits = ys > 0.0f ? 1000.0f * pow(ys, 0.2f) * max(s.r, max(s.g, s.b)) : 0.0f;\n"
+    "            v = pq(nits) * 4095.0f;\n"
+    "        } else {\n"
+    "            v = max(e.r, max(e.g, e.b)) * 4095.0f;\n"
+    "        }\n"
+    "    }\n"
+    "    float sum = simd_sum(in ? v : 0.0f);\n"
+    "    uint count = simd_sum(in ? 1u : 0u);\n"
+    "    float lo = simd_min(in ? v : 4096.0f);\n"
+    "    float hi = simd_max(in ? v : 0.0f);\n"
+    "    if (lane == 0) { t_sum[sg] = sum; t_count[sg] = count; t_lo[sg] = lo; t_hi[sg] = hi; }\n"
+    "    threadgroup_barrier(mem_flags::mem_threadgroup);\n"
+    "    if (tid == 0) {\n"
+    "        l1_part r = { 0.0f, 0u, 4096.0f, 0.0f };\n"
+    "        for (uint i = 0; i < sgs; i++) {\n"
+    "            r.sum += t_sum[i]; r.count += t_count[i];\n"
+    "            r.lo = min(r.lo, t_lo[i]); r.hi = max(r.hi, t_hi[i]);\n"
+    "        }\n"
+    "        out[group.y * groups.x + group.x] = r;\n"
+    "    }\n"
+    "}\n";
+
+struct l1_params { uint32_t x0, y0, x1, y1, hlg; };
+struct l1_part { float sum; uint32_t count; float lo, hi; };
+
 // Frames in flight: the layer shows one, a few wait to be shown, one is being rendered. A buffer comes back into use
 // this many frames after it was enqueued (IOSurfaceIsInUse can't tell: it reports the layer's buffers as in use
 // all the time).
@@ -60,6 +130,14 @@ struct mac_sample_buffer {
     char *rpu_path;
     NSMutableArray<NSData *> *file_rpus;
     int64_t last_index;
+    // --macos-dovi-live-l1
+    bool live_l1;
+    bool l1_failed;
+    id<MTLCommandQueue> l1_queue;
+    id<MTLComputePipelineState> l1_pipeline;
+    id<MTLBuffer> l1_parts;
+    uint8_t *l1_rpu;
+    size_t l1_rpu_size;
 };
 
 struct mac_sample_buffer *mac_sample_buffer_create(struct mp_log *log, void *layer)
@@ -101,6 +179,9 @@ void mac_sample_buffer_destroy(struct mac_sample_buffer **sbp, pl_gpu gpu)
         CFRelease(sb->rpu);
     av_buffer_unref(&sb->rpu_src);
     [sb->file_rpus release];
+    [sb->l1_parts release];
+    [sb->l1_pipeline release];
+    [sb->l1_queue release];
     [sb->device release];
     [sb->layer release];
     talloc_free(sb);
@@ -152,6 +233,14 @@ void mac_sample_buffer_set_rpu_file(struct mac_sample_buffer *sb, const char *pa
     MP_VERBOSE(sb, "%d Dolby Vision RPUs from %s.\n", (int)rpus.count, path);
 }
 
+void mac_sample_buffer_set_live_l1(struct mac_sample_buffer *sb, bool live)
+{
+    if (sb && sb->live_l1 != live) {
+        sb->live_l1 = live;
+        sb->last_index = -1;
+    }
+}
+
 bool mac_sample_buffer_failed(struct mac_sample_buffer *sb)
 {
     return sb && sb->failed;
@@ -403,6 +492,93 @@ static void tag(CVPixelBufferRef buf, enum pl_color_system sys, const struct pl_
         CFRelease(cll);
 }
 
+static bool l1_init(struct mac_sample_buffer *sb)
+{
+    NSError *err = nil;
+    id<MTLLibrary> lib = [sb->device newLibraryWithSource:@(l1_kernel) options:nil error:&err];
+    id<MTLFunction> fn = [lib newFunctionWithName:@"l1"];
+    if (fn)
+        sb->l1_pipeline = [sb->device newComputePipelineStateWithFunction:fn error:&err];
+    [fn release];
+    [lib release];
+    sb->l1_queue = [sb->device newCommandQueue];
+    if (!sb->l1_pipeline || !sb->l1_queue) {
+        MP_ERR(sb, "Can't measure frames for their Dolby Vision L1: %s\n",
+               err ? err.localizedDescription.UTF8String : "no command queue");
+        return false;
+    }
+    return true;
+}
+
+// The frame's L1 (min, avg, max in 12-bit PQ codes), measured inside `video` on the GPU; false if it can't be
+static bool l1_measure(struct mac_sample_buffer *sb, struct slot *s, const struct pl_color_space *c,
+                       struct pl_rect2d video, int out[3])
+{
+    if (sb->l1_failed)
+        return false;
+    if (c->transfer != PL_COLOR_TRC_HLG && c->transfer != PL_COLOR_TRC_PQ)
+        return false;
+    if (!sb->l1_pipeline && !l1_init(sb)) {
+        sb->l1_failed = true;
+        return false;
+    }
+    // The video's rectangle in the buffer, or all of it
+    pl_rect2d_normalize(&video);
+    struct l1_params par = {
+        .x0 = MPCLAMP(video.x0, 0, sb->w), .y0 = MPCLAMP(video.y0, 0, sb->h),
+        .x1 = MPCLAMP(video.x1, 0, sb->w), .y1 = MPCLAMP(video.y1, 0, sb->h),
+        .hlg = c->transfer == PL_COLOR_TRC_HLG,
+    };
+    if (par.x1 - par.x0 < 2 || par.y1 - par.y0 < 2) {
+        par.x0 = par.y0 = 0;
+        par.x1 = sb->w;
+        par.y1 = sb->h;
+    }
+    MTLSize group = MTLSizeMake(16, 16, 1);
+    MTLSize groups = MTLSizeMake((par.x1 - par.x0 + 15) / 16, (par.y1 - par.y0 + 15) / 16, 1);
+    size_t size = groups.width * groups.height * sizeof(struct l1_part);
+    if (sb->l1_parts.length < size) {
+        [sb->l1_parts release];
+        sb->l1_parts = [sb->device newBufferWithLength:size options:MTLResourceStorageModeShared];
+        if (!sb->l1_parts)
+            return false;
+    }
+    id<MTLCommandBuffer> cmd = [sb->l1_queue commandBuffer];
+    id<MTLComputeCommandEncoder> enc = [cmd computeCommandEncoder];
+    [enc setComputePipelineState:sb->l1_pipeline];
+    [enc setTexture:CVMetalTextureGetTexture(s->mtl[0]) atIndex:0];
+    [enc setTexture:CVMetalTextureGetTexture(s->mtl[1]) atIndex:1];
+    [enc setBytes:&par length:sizeof(par) atIndex:0];
+    [enc setBuffer:sb->l1_parts offset:0 atIndex:1];
+    [enc dispatchThreadgroups:groups threadsPerThreadgroup:group];
+    [enc endEncoding];
+    [cmd commit];
+    [cmd waitUntilCompleted];
+    if (cmd.status != MTLCommandBufferStatusCompleted) {
+        MP_ERR(sb, "Measuring the frame's L1 failed: %s\n",
+               cmd.error ? cmd.error.localizedDescription.UTF8String : "?");
+        sb->l1_failed = true;
+        return false;
+    }
+
+    const struct l1_part *parts = sb->l1_parts.contents;
+    double sum = 0, count = 0, lo = 4096, hi = 0;
+    for (size_t i = 0; i < groups.width * groups.height; i++) {
+        if (!parts[i].count)
+            continue;
+        sum += parts[i].sum;
+        count += parts[i].count;
+        lo = MPMIN(lo, parts[i].lo);
+        hi = MPMAX(hi, parts[i].hi);
+    }
+    if (!count)
+        return false;
+    out[0] = lrint(lo);
+    out[1] = lrint(sum / count);
+    out[2] = lrint(hi);
+    return true;
+}
