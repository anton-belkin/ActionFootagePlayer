diff --git a/video/out/mac/dovi_l1.c b/video/out/mac/dovi_l1.c
new file mode 100644
index 000000000..46e2ce4fa
--- /dev/null
+++ b/video/out/mac/dovi_l1.c
@@ -0,0 +1,137 @@
+/*
+ * This file is part of mpv.
+ *
+ * mpv is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * mpv is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with mpv.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include <stdbool.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "dovi_l1.h"
+
+// An extension block starts byte-aligned with ext_block_length ue(v) and ext_block_level u(8): L1's length 5 is
+// ue "00110" and its level "00000001", 13 bits; then min_pq, max_pq, avg_pq (12 bits each) and 4 reserved zero bits.
+#define L1_HEADER      0x0601u
+#define L1_HEADER_BITS 13
+
+static unsigned get_bits(const uint8_t *b, size_t bit, int n)
+{
+    unsigned v = 0;
+    for (int i = 0; i < n; i++, bit++)
+        v = (v << 1) | ((b[bit >> 3] >> (7 - (bit & 7))) & 1);
+    return v;
+}
+
+static void put_bits(uint8_t *b, size_t bit, int n, unsigned v)
+{
+    for (int i = n - 1; i >= 0; i--, bit++) {
+        uint8_t mask = 1 << (7 - (bit & 7));
+        b[bit >> 3] = ((v >> i) & 1) ? (b[bit >> 3] | mask) : (b[bit >> 3] & ~mask);
+    }
+}
+
+// CRC-32/MPEG-2, as the RPU's rpu_data_crc32
+static uint32_t crc32_mpeg2(const uint8_t *b, size_t n)
+{
+    uint32_t crc = 0xffffffff;
+    for (size_t i = 0; i < n; i++) {
+        crc ^= (uint32_t)b[i] << 24;
+        for (int k = 0; k < 8; k++)
+            crc = (crc & 0x80000000) ? (crc << 1) ^ 0x04c11db7 : crc << 1;
+    }
+    return crc;
+}
+
+static int clamp(int v, int lo, int hi)
+{
+    return v < lo ? lo : v > hi ? hi : v;
+}
+
+size_t mp_dovi_rpu_set_l1(const uint8_t *rpu, size_t size, int min_pq, int avg_pq, int max_pq,
+                          uint8_t *out, size_t out_size)
+{
+    // prefix, at least an L1 block, CRC32, the 0x80 end
+    if (size < 12 || rpu[0] != 0x19 || out_size < size + size / 2 + 8)
+        return 0;
+
+    // Without the emulation prevention bytes (a 3 after two zeros)
+    uint8_t *raw = malloc(size);
+    if (!raw)
+        return 0;
+    size_t n = 0;
+    int zeros = 0;
+    for (size_t i = 0; i < size; i++) {
+        if (zeros >= 2 && rpu[i] == 3) {
+            zeros = 0;
+            continue;
+        }
+        raw[n++] = rpu[i];
+        zeros = rpu[i] ? 0 : zeros + 1;
+    }
+    if (n < 12 || raw[n - 1] != 0x80) {
+        free(raw);
+        return 0;
+    }
+    size_t crc_at = n - 5;
+    if (crc32_mpeg2(raw + 1, crc_at - 1) != ((uint32_t)raw[crc_at] << 24 | raw[crc_at + 1] << 16 |
+                                             raw[crc_at + 2] << 8 | raw[crc_at + 3]))
+    {
+        free(raw);
+        return 0;
+    }
+
+    // The L1 block: byte-aligned, its header and reserved bits as they must be and its values valid; the last such
+    // place before the CRC (the display management data comes after the reshaping curves, whose bits could look
+    // like one by chance)
+    size_t at = 0;
+    for (size_t byte = 1; (byte * 8) + L1_HEADER_BITS + 40 <= crc_at * 8; byte++) {
+        size_t bit = byte * 8;
+        if (get_bits(raw, bit, L1_HEADER_BITS) != L1_HEADER)
+            continue;
+        size_t p = bit + L1_HEADER_BITS;
+        unsigned mn = get_bits(raw, p, 12), mx = get_bits(raw, p + 12, 12), avg = get_bits(raw, p + 24, 12);
+        if (get_bits(raw, p + 36, 4) || mn > mx || avg > mx)
+            continue;
+        at = p;
+    }
+    if (!at) {
+        free(raw);
+        return 0;
+    }
+
+    max_pq = clamp(max_pq, 2081, 4095);
+    put_bits(raw, at, 12, clamp(min_pq, 0, 12));
+    put_bits(raw, at + 12, 12, max_pq);
+    put_bits(raw, at + 24, 12, clamp(avg_pq, 1229, max_pq - 1));
+    uint32_t crc = crc32_mpeg2(raw + 1, crc_at - 1);
+    raw[crc_at] = crc >> 24;
+    raw[crc_at + 1] = crc >> 16;
+    raw[crc_at + 2] = crc >> 8;
+    raw[crc_at + 3] = crc;
+
+    // Emulation prevention again: a 3 before any byte up to 3 that follows two zeros
+    size_t o = 0;
+    zeros = 0;
+    for (size_t i = 0; i < n; i++) {
+        if (zeros >= 2 && raw[i] <= 3) {
+            out[o++] = 3;
+            zeros = 0;
+        }
+        out[o++] = raw[i];
+        zeros = raw[i] ? 0 : zeros + 1;
+    }
+    free(raw);
+    return o;
+}
