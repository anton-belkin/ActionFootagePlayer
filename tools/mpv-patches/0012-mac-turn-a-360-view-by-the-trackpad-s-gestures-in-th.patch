+ */
+
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+struct vo;
+
+// The trackpad's gestures straight to a 360 view's shader parameters (view360_yaw, _pitch, _roll,
+// _fov, _projection), between the updates of the script that turns them exactly: each gesture
+// message (--macos-gesture-messages) has a number; the script says in --glsl-shader-opts which it
+// has applied (afp_input_seq), and the VO turns the view by the ones after it before it draws, and
+// is woken to draw as each comes in. Without afp_input_seq nothing is added.
+
+enum mac_gesture_kind {
+    MAC_GESTURE_NONE = 0,   // a message the view doesn't act on (a momentum scroll...)
+    MAC_GESTURE_PAN,        // a, b: the picture moved by so many pixels, right and down
+    MAC_GESTURE_ZOOM,       // a: the factor, above 1 closer
+    MAC_GESTURE_ROLL,       // a: degrees, counterclockwise
+};
+
+// The VO to wake for a redraw (NULL: none); the VO thread
+void mac_gesture_set_vo(struct vo *vo);
+// Whether the VO adds the gestures to the view (the script asked for it with afp_input_seq)
+void mac_gesture_set_active(bool active);
+
+// A gesture message sent (the main thread): its number, which the message carries
+uint64_t mac_gesture_push(enum mac_gesture_kind kind, double a, double b, double time);
+
+struct mac_gesture_view {
+    float yaw, pitch, roll, fov;
+    int projection;     // 0 auto, 1 rectilinear, 2 stereographic, 3 little planet
+};
+
+// The VO thread: the view turned by the gestures after done (the script's afp_input_seq), for a
+// picture height px pixels high. Returns the newest gesture's time, 0 when there was none
+double mac_gesture_predict(uint64_t done, double height_px, struct mac_gesture_view *v);
diff --git a/video/out/mac/latency.c b/video/out/mac/latency.c
index 9bac1af31..01e043950 100644
--- a/video/out/mac/latency.c
+++ b/video/out/mac/latency.c
@@ -80,6 +80,15 @@ void mac_latency_frame_begin(double applied)
     mp_mutex_unlock(&lock);
 }
 
+void mac_latency_frame_applied(double applied)
+{
+    mp_mutex_lock(&lock);
+    if (current.id && ring[current.id % RING].id == current.id &&
+        applied > ring[current.id % RING].applied)
+        ring[current.id % RING].applied = applied;
+    mp_mutex_unlock(&lock);
+}
+
 void mac_latency_frame_fresh(bool fresh)
 {
     mp_mutex_lock(&lock);
diff --git a/video/out/mac/latency.h b/video/out/mac/latency.h
index 91387ec3f..c42323a10 100644
--- a/video/out/mac/latency.h
+++ b/video/out/mac/latency.h
@@ -37,6 +37,8 @@ void mac_latency_input(double event_time);
 // The VO thread: a frame starts being drawn. applied: the time of the input event whose effect
 // the frame shows (0 when nobody said)
 void mac_latency_frame_begin(double applied);
+// The frame shows an input newer than the one begin was given (the VO applied it itself)
+void mac_latency_frame_applied(double applied);
 // The frame was rendered from the video frame (fresh), not taken from the renderer's cache
 void mac_latency_frame_fresh(bool fresh);
 // The frame is handed to the swapchain
diff --git a/video/out/mac/view.swift b/video/out/mac/view.swift
index 410c6146e..b3186c058 100644
--- a/video/out/mac/view.swift
+++ b/video/out/mac/view.swift
@@ -180,12 +180,29 @@ class View: NSView, CALayerDelegate {
         sendGesture(kind, values, phase, event.timestamp)
     }
 
-    // The event's time last (seconds of the host clock, as NSEvent.timestamp): a script passes it on in
-    // glsl-shader-opts as afp_input_time, for --macos-latency-log
+    // After the phase, the event's time (seconds of the host clock, as NSEvent.timestamp: a script
+    // passes it on in glsl-shader-opts as afp_input_time, for --macos-latency-log) and the message's
+    // number (afp_input_seq: the VO turns a 360 view by the gestures after it, video/out/mac/gesture_view.h)
     func sendGesture(_ kind: String, _ values: [Double], _ phase: String, _ time: TimeInterval) {
         mac_latency_input(time)
+        // What the view360 script does with it (gestures.lua): a scroll pans, a mouse's smooth wheel
+        // (no phase) zooms by 1.1 every 10 points, the coasting after the fingers left does nothing
+        var view = MAC_GESTURE_NONE
+        var a = 0.0, b = 0.0
+        let x = values.count > 0 ? values[0] : 0, y = values.count > 1 ? values[1] : 0
+        switch (kind, phase) {
+        case ("scroll", "momentum"): break
+        case ("scroll", "none"): if y != 0 { view = MAC_GESTURE_ZOOM; a = pow(1.1, y / 10) }
+        case ("scroll", _):
+            let scale = Double(window?.backingScaleFactor ?? 1)
+            view = MAC_GESTURE_PAN; a = x * scale; b = y * scale
+        case ("magnify", _): view = MAC_GESTURE_ZOOM; a = 1 + x
+        case ("rotate", _): view = MAC_GESTURE_ROLL; a = x
+        default: break
+        }
+        let seq = mac_gesture_push(view, a, b, time)
         let args = values.map { String(format: "%.4f", $0) }.joined(separator: " ")
-        input?.command("script-message gesture \(kind) \(args) \(phase) \(String(format: "%.6f", time))")
+        input?.command("script-message gesture \(kind) \(args) \(phase) \(String(format: "%.6f", time)) \(seq)")
     }
 
     // --macos-latency-test=<hz>: a two-finger scroll made up at that rate while the gestures are messages,
diff --git a/video/out/vo_gpu_next.c b/video/out/vo_gpu_next.c
index 0f9db6798..7ff8f3e23 100644
--- a/video/out/vo_gpu_next.c
+++ b/video/out/vo_gpu_next.c
@@ -54,17 +54,24 @@
 #include "gpu_next/context.h"
 
 #if HAVE_COCOA && HAVE_SWIFT
+#include "video/out/mac/gesture_view.h"
 #include "video/out/mac/latency.h"
 
+static const char *shader_opt(char **opts, const char *key)
+{
+    for (int n = 0; opts && opts[n * 2]; n++) {
+        if (strcmp(opts[n * 2], key) == 0)
+            return opts[n * 2 + 1];
+    }
+    return NULL;
+}
+
 // The time of the input whose effect the frame shows, as the script that turned it into shader
 // parameters said (glsl-shader-opts afp_input_time), for --macos-latency-log
 static double input_time(char **opts)
 {
-    for (int n = 0; opts && opts[n * 2]; n++) {
-        if (strcmp(opts[n * 2], "afp_input_time") == 0)
-            return strtod(opts[n * 2 + 1], NULL);
-    }
-    return 0;
+    const char *t = shader_opt(opts, "afp_input_time");
+    return t ? strtod(t, NULL) : 0;
 }
 #endif
 
@@ -168,6 +175,13 @@ struct priv {
     double last_pts;
     bool is_interpolated;
     bool rendered_fresh;    // this frame rendered a video frame (not from the cache)
+
+    // The 360 view's parameters, turned by the gestures the script hasn't applied yet
+    // (video/out/mac/gesture_view.h): yaw, pitch, roll, fov, projection, and the first four as
+    // the options set them
+    const struct pl_hook_par *view_par[5];
+    float view_base[4];
+    bool view_base_stale;
     bool want_reset;
     bool want_seek_reset;
     bool flush_cache;
@@ -1400,6 +1414,55 @@ static uint64_t hook_params_signature(const struct pl_hook *const *hooks, int nu
     return num_hooks ? h : 0;
 }
 
+#if HAVE_COCOA && HAVE_SWIFT
+// The 360 view (view360.glsl) turned by the trackpad's gestures its script hasn't applied yet:
+// the script's values (from --glsl-shader-opts) and the gestures after afp_input_seq
+static void turn_view(struct priv *p, char **opts)
+{
+    static const char *const names[5] = { "view360_yaw", "view360_pitch", "view360_roll",
+                                          "view360_fov", "view360_projection" };
+    if (p->view_base_stale) {
+        // Just set from the options: these are the script's values
+        p->view_base_stale = false;
+        memset(p->view_par, 0, sizeof(p->view_par));
+        for (int i = 0; i < p->pars->params.num_hooks; i++) {
+            const struct pl_hook *hook = p->pars->params.hooks[i];
+            for (int j = 0; j < hook->num_parameters; j++) {
+                for (int n = 0; n < 5; n++) {
+                    if (strcmp(hook->parameters[j].name, names[n]) == 0)
+                        p->view_par[n] = &hook->parameters[j];
+                }
+            }
+        }
+        for (int n = 0; n < 4; n++)
+            p->view_base[n] = p->view_par[n] ? p->view_par[n]->data->f : 0;
+    }
+    for (int n = 0; n < 5; n++) {
+        if (!p->view_par[n]) {
+            mac_gesture_set_active(false);
+            return;
+        }
+    }
+
+    const char *done = shader_opt(opts, "afp_input_seq");
+    mac_gesture_set_active(done != NULL);
+    struct mac_gesture_view v = {
+        .yaw = p->view_base[0], .pitch = p->view_base[1], .roll = p->view_base[2],
+        .fov = p->view_base[3], .projection = p->view_par[4]->data->i,
+    };
+    if (done) {
+        double t = mac_gesture_predict(strtoull(done, NULL, 10),
+                                       p->dst.y1 - p->dst.y0, &v);
+        if (t)
+            mac_latency_frame_applied(t);
+    }
+    p->view_par[0]->data->f = v.yaw;
+    p->view_par[1]->data->f = v.pitch;
+    p->view_par[2]->data->f = v.roll;
+    p->view_par[3]->data->f = v.fov;
+}
+#endif
+
 static bool draw_frame(struct vo *vo, struct vo_frame *frame)
 {
     struct priv *p = vo->priv;
@@ -1824,6 +1887,10 @@ static bool draw_frame(struct vo *vo, struct vo_frame *frame)
         for (int i = 0; i < pars->params.num_hooks; i++)
             update_hook_opts_dynamic(p, p->hooks[i], frame->current);
 
+#if HAVE_COCOA && HAVE_SWIFT
+        turn_view(p, opts->user_shader_opts);
+#endif
+
         // libplacebo reuses a cached frame while the render params' hash is
         // the same, and that hashes the hooks, not their parameters' values:
         // a frame drawn again with a parameter changed (a redraw, a frame
@@ -3105,6 +3172,7 @@ static void update_render_options(struct vo *vo)
     }
 
     pars->params.hooks = p->hooks;
+    p->view_base_stale = true;
 
     MP_DBG(p, "Render options updated, flushing renderer cache.\n");
     p->flush_cache = p->paused || !p->next_opts->inter_preserve;
