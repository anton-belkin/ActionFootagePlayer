new file mode 100644
index 000000000..78d429502
--- /dev/null
+++ b/video/out/mac/gesture_view.c
@@ -0,0 +1,138 @@
+/*
+ * This file is part of mpv.
+ *
+ * mpv is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * mpv is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with mpv.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include <math.h>
+
+#include "common/common.h"
+#include "osdep/threads.h"
+#include "video/out/vo.h"
+
+#include "gesture_view.h"
+
+// The gestures sent and not yet applied by the script: a few seconds' worth
+#define RING 512
+
+struct gesture {
+    uint64_t seq;
+    enum mac_gesture_kind kind;
+    double a, b, time;
+};
+
+static mp_static_mutex lock = MP_STATIC_MUTEX_INITIALIZER;
+static struct vo *wake_vo;
+static bool active;
+static uint64_t last_seq;
+static struct gesture ring[RING];
+
+void mac_gesture_set_vo(struct vo *vo)
+{
+    mp_mutex_lock(&lock);
+    wake_vo = vo;
+    mp_mutex_unlock(&lock);
+}
+
+void mac_gesture_set_active(bool on)
+{
+    mp_mutex_lock(&lock);
+    active = on;
+    mp_mutex_unlock(&lock);
+}
+
+uint64_t mac_gesture_push(enum mac_gesture_kind kind, double a, double b, double time)
+{
+    mp_mutex_lock(&lock);
+    uint64_t seq = ++last_seq;
+    ring[seq % RING] = (struct gesture){ .seq = seq, .kind = kind, .a = a, .b = b, .time = time };
+    // Drawn now, playing or paused, rather than when the script gets to it
+    if (active && wake_vo && kind != MAC_GESTURE_NONE)
+        vo_redraw(wake_vo);
+    mp_mutex_unlock(&lock);
+    return seq;
+}
+
+// view360's geometry (mpv/scripts/view360/view.lua, view360.glsl), near the picture's middle
+static const float fov_min[4] = { 20, 20, 20, 60 };
+static const float fov_max[4] = { 300, 150, 300, 330 };
+#define PITCH_MAX 89.9
+
+static double smoothstep(double a, double b, double x)
+{
+    double t = MPCLAMP((x - a) / (b - a), 0, 1);
+    return t * t * (3 - 2 * t);
+}
+
+static double wrap(double deg)
+{
+    deg = fmod(deg, 360);
+    if (deg > 180)
+        deg -= 360;
+    if (deg < -180)
+        deg += 360;
+    return deg;
+}
+
+static void turn(struct mac_gesture_view *v, const struct gesture *g, double height_px)
+{
+    int proj = MPCLAMP(v->projection, 0, 3);
+    switch (g->kind) {
+    case MAC_GESTURE_ZOOM:
+        if (g->a > 0)
+            v->fov = MPCLAMP(v->fov / g->a, fov_min[proj], fov_max[proj]);
+        break;
+    case MAC_GESTURE_ROLL:
+        v->roll = wrap(v->roll + g->a);
+        break;
+    case MAC_GESTURE_PAN: {
+        // The little planet spins and tilts about its middle: left to the script
+        if (proj == 3 || height_px <= 0)
+            break;
+        // The projection's distance d and scale k (r = k sin θ / (cos θ + d), in half heights):
+        // near the middle, a half height is (1 + d) / k radians
+        double d = proj == 1 ? 0 : proj == 2 ? 1 : smoothstep(100, 160, v->fov);
+        double half = v->fov * M_PI / 360;
+        double k = 16.0 / 9 * (cos(half) + d) / sin(half);
+        double rad_per_px = (1 + d) / k / (height_px / 2);
+        // The picture's axes turned by the roll into the head's
+        double r = v->roll * M_PI / 180;
+        double hx = g->a * cos(r) - g->b * sin(r);
+        double hy = g->a * sin(r) + g->b * cos(r);
+        double cp = MPMAX(0.05, cos(v->pitch * M_PI / 180));
+        // The picture moving right looks left, moving down looks up
+        v->yaw = wrap(v->yaw - hx * rad_per_px * 180 / M_PI / cp);
+        v->pitch = MPCLAMP(v->pitch + hy * rad_per_px * 180 / M_PI, -PITCH_MAX, PITCH_MAX);
+        break;
+    }
+    default:
+        break;
+    }
+}
+
+double mac_gesture_predict(uint64_t done, double height_px, struct mac_gesture_view *v)
+{
+    double newest = 0;
+    mp_mutex_lock(&lock);
+    uint64_t from = MPMAX(done + 1, last_seq >= RING ? last_seq - RING + 1 : 1);
+    for (uint64_t seq = from; seq <= last_seq; seq++) {
+        const struct gesture *g = &ring[seq % RING];
+        if (g->seq != seq || g->kind == MAC_GESTURE_NONE)
+            continue;
+        turn(v, g, height_px);
+        newest = MPMAX(newest, g->time);
+    }
+    mp_mutex_unlock(&lock);
+    return newest;
+}
