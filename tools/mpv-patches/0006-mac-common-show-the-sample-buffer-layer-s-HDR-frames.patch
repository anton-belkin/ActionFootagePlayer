diff --git a/video/out/mac_common.swift b/video/out/mac_common.swift
index b2b8c99d8..e8600a252 100644
--- a/video/out/mac_common.swift
+++ b/video/out/mac_common.swift
@@ -46,6 +46,7 @@ class MacCommon: Common {
             sampleLayer.frame = layer?.bounds ?? .zero
             layer?.addSublayer(sampleLayer)
             sampleBufferLayer = sampleLayer
+            updateSampleBufferRange()
             initMisc(vo)
         }
     }
@@ -119,6 +120,24 @@ class MacCommon: Common {
         info.pointee.last_queue_display_time = next?.time ?? -1
     }
 
+    // HDR frames shown with the display's headroom (EDR), as macOS's own players do, or toned down to
+    // SDR as on an SDR display (--macos-sample-buffer-edr). Since macOS 26 a layer is tone mapped to
+    // SDR unless it asks for more. On the main thread
+    func updateSampleBufferRange() {
+        guard let sampleLayer = sampleBufferLayer else { return }
+        let edr = option.mac.macos_sample_buffer_edr
+        // preferredDynamicRange is in the macOS 26 SDK (Swift 6.2) and later
+#if compiler(>=6.2)
+        if #available(macOS 26.0, *) {
+            sampleLayer.preferredDynamicRange = edr ? .high : .standard
+            return
+        }
+#endif
+        if #available(macOS 14.0, *) {
+            sampleLayer.wantsExtendedDynamicRangeContent = edr
+        }
+    }
+
     @objc func setSampleBufferVisible(_ visible: Bool) {
         DispatchQueue.main.async {
             CATransaction.begin()
