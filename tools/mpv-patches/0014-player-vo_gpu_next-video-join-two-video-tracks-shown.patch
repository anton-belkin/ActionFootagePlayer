diff --git a/player/loadfile.c b/player/loadfile.c
index d4427dff1..cea9581b4 100644
--- a/player/loadfile.c
+++ b/player/loadfile.c
@@ -1808,6 +1808,43 @@ done:
 
 // Start playing the current playlist entry.
 // Handle initialization and deinitialization.
+// --video-join: a file's first two video tracks of the same size and codec (a 360 camera's lenses, one a track) as
+// one picture, side by side. The second becomes a dependent track of the first, as a Dolby Vision enhancement layer
+// is: the demuxer reads it along, f_enhancement_pair decodes it (with the same hardware decoding) and attaches each
+// frame to the first track's of the same time, and the VO joins the two on the GPU. In place of lavfi-complex's
+// hstack, which decodes both to memory and joins them there
+static void join_video_tracks(struct MPContext *mpctx, struct demuxer *demuxer)
+{
+    struct sh_stream *v[2] = {0};
+    int n = 0;
+    for (int i = 0; i < demux_get_num_stream(demuxer) && n < 2; i++) {
+        struct sh_stream *sh = demux_get_stream(demuxer, i);
+        if (sh->type != STREAM_VIDEO || sh->image || sh->attached_picture || sh->dependent_track || sh->group)
+            continue;
+        v[n++] = sh;
+    }
+    if (n < 2)
+        return;
+    struct mp_codec_params *a = v[0]->codec, *b = v[1]->codec;
+    if (!a->codec || !b->codec || strcmp(a->codec, b->codec) != 0 ||
+        a->disp_w != b->disp_w || a->disp_h != b->disp_h || a->disp_w <= 0)
+    {
+        MP_WARN(mpctx, "--video-join: tracks %d and %d differ (%s %dx%d, %s %dx%d), not joined.\n",
+                v[0]->index, v[1]->index, a->codec ? a->codec : "?", a->disp_w, a->disp_h,
+                b->codec ? b->codec : "?", b->disp_w, b->disp_h);
+        return;
+    }
+    struct sh_stream_group *group = talloc_zero(v[0], struct sh_stream_group);
+    MP_TARRAY_APPEND(group, group->members, group->num_members, v[0]);
+    MP_TARRAY_APPEND(group, group->members, group->num_members, v[1]);
+    v[0]->group = group;
+    v[1]->group = group;
+    v[1]->dependent_track = true;
+    v[1]->join_right = true;
+    MP_INFO(mpctx, "Video tracks %d and %d joined side by side (%dx%d each).\n",
+            v[0]->index, v[1]->index, a->disp_w, a->disp_h);
+}
+
 static void play_current_file(struct MPContext *mpctx)
 {
     struct MPOpts *opts = mpctx->opts;
@@ -1948,6 +1985,8 @@ static void play_current_file(struct MPContext *mpctx)
 
     if (mpctx->opts->rebase_start_time)
         demux_set_ts_offset(mpctx->demuxer, -mpctx->demuxer->start_time);
+    if (mpctx->opts->video_join)
+        join_video_tracks(mpctx, mpctx->demuxer);
     enable_demux_thread(mpctx, mpctx->demuxer);
 
     add_demuxer_tracks(mpctx, mpctx->demuxer);
