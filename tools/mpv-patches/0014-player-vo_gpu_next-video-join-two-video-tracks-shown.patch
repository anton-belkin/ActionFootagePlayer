     struct timer_pool *sw_upload_timer;
     struct mp_pass_perf sw_upload_perf;
 
@@ -632,6 +636,8 @@ struct frame_priv {
     struct ra_hwdec *el_hwdec;
     pl_tex el_tex[4];
     struct pl_frame el_frame;
+    // --video-join: the joined frame's planes, this frame's own
+    pl_tex join_tex[4];
 };
 
 static int plane_data_from_imgfmt(struct pl_plane_data out_data[4],
@@ -904,6 +910,72 @@ static void slot_release(struct hwdec_slot *s)
     s->acquired = false;
 }
 
+// A frame's own params: a joined frame's (--video-join) are of the two side by side, the hardware surface only of its
+// own picture
+static struct mp_image_params own_params(struct mp_image *mpi)
+{
+    struct mp_image_params par = mpi->params;
+    if (mpi->join_el && mpi->join_w > 0) {
+        par.w = mpi->join_w;
+        par.crop = (struct mp_rect){0, 0, par.w, par.h};
+    }
+    return par;
+}
+
+// --video-join: the frame and the picture joined to it (enhancement_layer), both mapped from their hardware surfaces
+// and drawn side by side into planes of their own (the mapped textures can be sampled, not blitted), the mappings
+// released at once: the frame's planes are then textures like any uploaded frame's
+static bool map_joined(struct priv *p, pl_gpu gpu, struct mp_image *mpi, struct pl_frame *frame)
+{
+    struct frame_priv *fp = mpi->priv;
+    struct mp_image *el = mpi->enhancement_layer;
+    fp->el_hwdec = ra_hwdec_get(&p->hwdec_ctx, el->imgfmt);
+    if (!fp->el_hwdec || !slot_reconfig(p, &p->el_hwdec, fp->el_hwdec, &el->params))
+        return false;
+    if (!p->join_dp)
+        p->join_dp = pl_dispatch_create(p->pllog, gpu);
+
+    struct pl_frame a = *frame, b = *frame;
+    bool ok = slot_acquire(p, &p->hwdec, mpi, mpi, &a) && slot_acquire(p, &p->el_hwdec, mpi, el, &b);
+    for (int n = 0; ok && n < frame->num_planes; n++) {
+        pl_tex ta = a.planes[n].texture, tb = b.planes[n].texture;
+        if (!ta || !tb || ta->params.h != tb->params.h || ta->params.format != tb->params.format) {
+            MP_ERR(p, "--video-join: the pictures' planes differ.\n");
+            ok = false;
+            break;
+        }
+        ok = pl_tex_recreate(gpu, &fp->join_tex[n], pl_tex_params(
+            .w = ta->params.w + tb->params.w,
+            .h = ta->params.h,
+            .format = ta->params.format,
+            .sampleable = true,
+            .renderable = true,
+        ));
+        if (!ok) {
+            MP_ERR(p, "--video-join: can't make a joined plane of %s.\n", ta->params.format->name);
+            break;
+        }
+        pl_tex parts[2] = {ta, tb};
+        int x = 0;
+        for (int i = 0; i < 2; i++) {
+            pl_shader sh = pl_dispatch_begin(p->join_dp);
+            pl_shader_sample_direct(sh, pl_sample_src(.tex = parts[i]));
+            ok = ok && pl_dispatch_finish(p->join_dp, pl_dispatch_params(
+                .shader = &sh,
+                .target = fp->join_tex[n],
+                .rect = {x, 0, x + parts[i]->params.w, parts[i]->params.h},
+            ));
+            x += parts[i]->params.w;
+        }
+        frame->planes[n].texture = fp->join_tex[n];
+    }
+    slot_release(&p->hwdec);
+    slot_release(&p->el_hwdec);
+    slot_unmap(p, &p->hwdec);
+    slot_unmap(p, &p->el_hwdec);
+    return ok;
+}
+
 static bool hwdec_acquire(pl_gpu gpu, struct pl_frame *frame)
 {
     struct mp_image *mpi = frame->user_data;
@@ -1044,17 +1116,23 @@ static bool map_frame(pl_gpu gpu, pl_tex *tex, const struct pl_source_frame *src
     struct priv *p = vo->priv;
 
     fp->hwdec = ra_hwdec_get(&p->hwdec_ctx, mpi->imgfmt);
+    bool join = mpi->join_el && mpi->enhancement_layer;
     if (fp->hwdec) {
         // Note: We don't actually need the mapper to map the frame yet, we
         // only reconfig the mapper here (potentially creating it) to access
         // `dst_params`. In practice, though, this should not matter unless the
         // image format changes mid-stream.
-        if (!slot_reconfig(p, &p->hwdec, fp->hwdec, &mpi->params)) {
+        struct mp_image_params own = own_params(mpi);
+        if (!slot_reconfig(p, &p->hwdec, fp->hwdec, &own)) {
             talloc_free(mpi);
             return false;
         }
 
         par = p->hwdec.mapper->dst_params;
+        if (join) {
+            par.w = mpi->params.w;
+            par.crop = mpi->params.crop;
+        }
     }
 
     mp_image_params_guess_csp(&par);
@@ -1081,7 +1159,17 @@ static bool map_frame(pl_gpu gpu, pl_tex *tex, const struct pl_source_frame *src
         frame->color.transfer = PL_COLOR_TRC_GAMMA22;
     }
 
-    if (fp->hwdec) {
+    if (fp->hwdec && join) {
+        p->sw_upload_perf.count = 0;
+
+        struct mp_imgfmt_desc desc = mp_imgfmt_get_desc(par.imgfmt);
+        setup_hwdec_plane_mapping(frame, &desc);
+        if (!map_joined(p, gpu, mpi, frame)) {
+            MP_ERR(vo, "Failed joining the frame's pictures!\n");
+            talloc_free(mpi);
+            return false;
+        }
+    } else if (fp->hwdec) {
         p->sw_upload_perf.count = 0;
 
         struct mp_imgfmt_desc desc = mp_imgfmt_get_desc(par.imgfmt);
@@ -1110,7 +1198,7 @@ static bool map_frame(pl_gpu gpu, pl_tex *tex, const struct pl_source_frame *src
     // Update chroma location, must be done after initializing planes
     pl_frame_set_chroma_location(frame, par.chroma_location);
 
-    if (mpi->enhancement_layer) {
+    if (mpi->enhancement_layer && !join) {
         struct mp_image *el = mpi->enhancement_layer;
         fp->el_hwdec = ra_hwdec_get(&p->hwdec_ctx, el->imgfmt);
 
@@ -1177,6 +1265,8 @@ static void unmap_frame(pl_gpu gpu, struct pl_frame *frame,
         if (tex)
             MP_TARRAY_APPEND(p, p->sub_tex, p->num_sub_tex, tex);
     }
+    for (int i = 0; i < MP_ARRAY_SIZE(fp->join_tex); i++)
+        pl_tex_destroy(gpu, &fp->join_tex[i]);
     for (int i = 0; i < MP_ARRAY_SIZE(fp->el_tex); i++) {
         if (fp->el_tex[i])
             pl_tex_destroy(gpu, &fp->el_tex[i]);
@@ -2684,6 +2774,7 @@ static void uninit(struct vo *vo)
 
     pl_icc_close(&p->icc_profile);
     pl_renderer_destroy(&p->rr);
+    pl_dispatch_destroy(&p->join_dp);
 
     for (int i = 0; i < VO_PASS_PERF_MAX; ++i) {
         pl_shader_info_deref(&p->perf_fresh.info[i].shader);
-- 
