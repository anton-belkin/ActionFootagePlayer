 };
 
+// A joined pair: the params of the two side by side, the BL's own width kept. Square pixels stay square (the picture
+// twice as wide); pixels made otherwise (--video-aspect-override, which each decoder applies to its own picture) keep
+// the display aspect it set
+static void join_pair(struct mp_image *bl, struct mp_image *el)
+{
+    bl->join_el = true;
+    bl->join_w = bl->params.w;
+    int total = bl->params.w + el->params.w;
+    if (bl->params.p_w > 0 && bl->params.p_h > 0 && bl->params.p_w != bl->params.p_h) {
+        int64_t pw = (int64_t)bl->params.p_w * bl->params.w, ph = (int64_t)bl->params.p_h * total;
+        while (pw > INT_MAX || ph > INT_MAX) { pw /= 2; ph /= 2; }
+        bl->params.p_w = pw;
+        bl->params.p_h = ph;
+    }
+    bl->params.w = total;
+    bl->params.crop = (struct mp_rect){0, 0, bl->params.w, bl->params.h};
+}
+
 static int pts_cmp(double a, double b)
 {
     if (a == MP_NOPTS_VALUE || b == MP_NOPTS_VALUE)
@@ -151,6 +173,12 @@ static void pair_process(struct mp_filter *f)
         if (p->num_el_pending > 0 && cmp == 0) {
             struct mp_image *el = take_head(&p->el_pending, &p->num_el_pending);
             take_head(&p->bl_pending, &p->num_bl_pending);
+            if (p->join) {
+                bl->enhancement_layer = el;
+                join_pair(bl, el);
+                mp_pin_in_write(out, MAKE_FRAME(MP_FRAME_VIDEO, bl));
+                continue;
+            }
             inherit_dovi_from_el(bl, el);
             if (bl->params.no_enhancement_layer) {
                 talloc_free(el);
@@ -177,6 +205,11 @@ static void pair_process(struct mp_filter *f)
                    p->num_el_pending > 0 ? p->el_pending[0]->pts : -1.0);
 
         take_head(&p->bl_pending, &p->num_bl_pending);
+        if (p->join) {
+            // Half a picture would set the VO up at another size: left out
+            talloc_free(bl);
+            continue;
+        }
         bl->enhancement_layer = NULL;
         mp_pin_in_write(out, MAKE_FRAME(MP_FRAME_VIDEO, bl));
     }
@@ -225,6 +258,7 @@ struct mp_filter *mp_enhancement_pair_create(struct mp_filter *parent,
     mp_filter_add_pin(f, MP_PIN_OUT, "out");
 
     struct priv *p = f->priv;
+    p->join = el_sh->join_right;
     p->el_dec = mp_decoder_wrapper_create(f, el_sh);
     if (p->el_dec)
         mp_decoder_wrapper_set_extra_hw_frames(p->el_dec, QUEUE_MAX);
