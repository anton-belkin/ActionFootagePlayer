diff --git a/video/out/mac/sample_buffer.h b/video/out/mac/sample_buffer.h
index 93b57c2d3..79527580b 100644
--- a/video/out/mac/sample_buffer.h
+++ b/video/out/mac/sample_buffer.h
@@ -37,5 +37,10 @@ bool mac_sample_buffer_start_frame(struct mac_sample_buffer *sb, pl_gpu gpu, int
 void mac_sample_buffer_submit(struct mac_sample_buffer *sb, pl_gpu gpu, struct ra_ext_frame *frame,
                               const struct ra_ext_submit *info);
 
+// Dolby Vision RPUs to attach in place of the frame's own: a file as dovi_tool writes them (Annex B, one RPU per
+// frame), the frame's by its pts times its nominal frame rate; one RPU goes on every frame. NULL or "" for none.
+// Read again when the path changes.
+void mac_sample_buffer_set_rpu_file(struct mac_sample_buffer *sb, const char *path);
+
 // Drops the frame the layer shows, when the swapchain takes over again
 void mac_sample_buffer_flush(struct mac_sample_buffer *sb);
diff --git a/video/out/mac/sample_buffer.m b/video/out/mac/sample_buffer.m
index 503b8fda5..31f01ddf5 100644
--- a/video/out/mac/sample_buffer.m
+++ b/video/out/mac/sample_buffer.m
@@ -56,6 +56,10 @@ struct mac_sample_buffer {
     CFDataRef rpu;
     AVBufferRef *rpu_src;
     struct pl_color_space tagged;
+    // --macos-dovi-rpu-file
+    char *rpu_path;
+    NSMutableArray<NSData *> *file_rpus;
+    int64_t last_index;
 };
 
 struct mac_sample_buffer *mac_sample_buffer_create(struct mp_log *log, void *layer)
@@ -96,12 +100,58 @@ void mac_sample_buffer_destroy(struct mac_sample_buffer **sbp, pl_gpu gpu)
     if (sb->rpu)
         CFRelease(sb->rpu);
     av_buffer_unref(&sb->rpu_src);
+    [sb->file_rpus release];
     [sb->device release];
     [sb->layer release];
     talloc_free(sb);
     *sbp = NULL;
 }
 
+void mac_sample_buffer_set_rpu_file(struct mac_sample_buffer *sb, const char *path)
+{
+    if (!sb)
+        return;
+    if (!path)
+        path = "";
+    if (sb->rpu_path && !strcmp(sb->rpu_path, path))
+        return;
+    talloc_free(sb->rpu_path);
+    sb->rpu_path = talloc_strdup(sb, path);
+    [sb->file_rpus release];
+    sb->file_rpus = nil;
+    sb->last_index = -1;
+    if (!path[0])
+        return;
+
+    NSData *data = [NSData dataWithContentsOfFile:@(path)];
+    if (!data) {
+        MP_ERR(sb, "Can't read the Dolby Vision RPU file %s.\n", path);
+        return;
+    }
+    // Annex B: each RPU after a 00 00 00 01 start code, as dovi_tool writes them (the NAL payload, emulation
+    // prevention bytes kept: what libavcodec exports and macOS's decoder attaches)
+    const uint8_t *b = data.bytes;
+    size_t n = data.length, start = SIZE_MAX;
+    NSMutableArray<NSData *> *rpus = [NSMutableArray new];
+    for (size_t i = 0; i + 4 <= n; i++) {
+        if (b[i] || b[i + 1] || b[i + 2] || b[i + 3] != 1)
+            continue;
+        if (start != SIZE_MAX && i > start)
+            [rpus addObject:[data subdataWithRange:NSMakeRange(start, i - start)]];
+        start = i + 4;
+        i += 3;
+    }
+    if (start != SIZE_MAX && start < n)
+        [rpus addObject:[data subdataWithRange:NSMakeRange(start, n - start)]];
+    if (!rpus.count) {
+        MP_ERR(sb, "No RPUs in %s.\n", path);
+        [rpus release];
+        return;
+    }
+    sb->file_rpus = rpus;
+    MP_VERBOSE(sb, "%d Dolby Vision RPUs from %s.\n", (int)rpus.count, path);
+}
+
 void mac_sample_buffer_flush(struct mac_sample_buffer *sb)
 {
     if (sb)
@@ -369,8 +419,22 @@ void mac_sample_buffer_submit(struct mac_sample_buffer *sb, pl_gpu gpu, struct r
     }
     tag(s->buf, s->sys, &info->color);
 
-    // The frame's Dolby Vision RPU, for the system's display management; kept as long as it's the same buffer
-    if (!info->dovi_rpu || !sb->rpu_src || info->dovi_rpu->buffer != sb->rpu_src->buffer) {
+    // The frame's Dolby Vision RPU, for the system's display management: from --macos-dovi-rpu-file, by the frame's
+    // number, or its own (kept as long as it's the same buffer)
+    if (sb->file_rpus) {
+        int64_t count = sb->file_rpus.count, index = 0;
+        if (info->pts != MP_NOPTS_VALUE && info->nominal_fps > 0)
+            index = MPCLAMP(llrint(info->pts * info->nominal_fps), 0, count - 1);
+        if (index != sb->last_index) {
+            if (sb->rpu)
+                CFRelease(sb->rpu);
+            sb->rpu = (CFDataRef)CFRetain((__bridge CFDataRef)sb->file_rpus[index]);
+            av_buffer_unref(&sb->rpu_src);
+            sb->last_index = index;
+            MP_TRACE(sb, "RPU %lld of %lld for pts %f.\n", (long long)index, (long long)count, info->pts);
+        }
+    } else if (!info->dovi_rpu || !sb->rpu_src || info->dovi_rpu->buffer != sb->rpu_src->buffer) {
+        sb->last_index = -1;
         if (sb->rpu)
             CFRelease(sb->rpu);
         sb->rpu = NULL;
