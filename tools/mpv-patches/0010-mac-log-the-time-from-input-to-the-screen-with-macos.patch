diff --git a/video/out/mac/latency.c b/video/out/mac/latency.c
new file mode 100644
index 000000000..5d52e1263
--- /dev/null
+++ b/video/out/mac/latency.c
@@ -0,0 +1,120 @@
+/*
+ * This file is part of mpv.
+ *
+ * mpv is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * mpv is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with mpv.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include "common/msg.h"
+#include "osdep/threads.h"
+#include "osdep/timer.h"
+
+#include "latency.h"
+
+// The frames drawn and not yet shown, by id (a drawable can be shown after a few more were drawn)
+#define RING 64
+
+struct record {
+    uint64_t id;
+    double applied, newest, begin, drawable, submit;
+};
+
+static mp_static_mutex lock = MP_STATIC_MUTEX_INITIALIZER;
+static struct mp_log *latency_log;
+static double newest_input;
+static uint64_t next_id = 1;
+static struct record current;
+static struct record ring[RING];
+
+double mac_latency_now(void)
+{
+    return mp_raw_time_ns() * 1e-9;
+}
+
+void mac_latency_set_log(struct mp_log *log)
+{
+    mp_mutex_lock(&lock);
+    latency_log = log;
+    mp_mutex_unlock(&lock);
+}
+
+bool mac_latency_enabled(void)
+{
+    mp_mutex_lock(&lock);
+    bool on = latency_log != NULL;
+    mp_mutex_unlock(&lock);
+    return on;
+}
+
+void mac_latency_input(double event_time)
+{
+    mp_mutex_lock(&lock);
+    if (event_time > newest_input)
+        newest_input = event_time;
+    mp_mutex_unlock(&lock);
+}
+
+void mac_latency_frame_begin(double applied)
+{
+    double now = mac_latency_now();
+    mp_mutex_lock(&lock);
+    current = (struct record){
+        .id = latency_log ? next_id++ : 0,
+        .applied = applied,
+        .newest = newest_input,
+        .begin = now,
+    };
+    if (current.id)
+        ring[current.id % RING] = current;
+    mp_mutex_unlock(&lock);
+}
+
+void mac_latency_frame_submitted(void)
+{
+    double now = mac_latency_now();
+    mp_mutex_lock(&lock);
+    if (current.id && ring[current.id % RING].id == current.id)
+        ring[current.id % RING].submit = now;
+    mp_mutex_unlock(&lock);
+}
+
+uint64_t mac_latency_drawable(void)
+{
+    double now = mac_latency_now();
+    mp_mutex_lock(&lock);
+    uint64_t id = latency_log ? current.id : 0;
+    if (id && ring[id % RING].id == id) {
+        // A second drawable for the same frame: the first one's frame wasn't this one
+        if (ring[id % RING].drawable)
+            id = 0;
+        else
+            ring[id % RING].drawable = now;
+    }
+    mp_mutex_unlock(&lock);
+    return id;
+}
+
+void mac_latency_presented(uint64_t id, double presented)
+{
+    mp_mutex_lock(&lock);
+    struct record *r = &ring[id % RING];
+    if (latency_log && id && r->id == id) {
+        // One line per frame, the times as they are (tools/latency360/summarize.py reads them)
+        mp_msg(latency_log, MSGL_INFO,
+               "frame=%" PRIu64 " applied=%.6f newest=%.6f begin=%.6f drawable=%.6f "
+               "submit=%.6f shown=%.6f\n", r->id, r->applied, r->newest, r->begin,
+               r->drawable, r->submit, presented);
+        r->id = 0;
+    }
+    mp_mutex_unlock(&lock);
+}
