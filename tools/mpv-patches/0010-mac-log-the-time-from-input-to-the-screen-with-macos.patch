+ */
+
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+struct mp_log;
+
+// --macos-latency-log: per frame shown, from the input it shows to the light. All times are
+// seconds of the host clock (mach_absolute_time), as NSEvent.timestamp, CACurrentMediaTime()
+// and a drawable's presentedTime are.
+
+// The log to write to, or NULL to stop (the VO thread)
+void mac_latency_set_log(struct mp_log *log);
+bool mac_latency_enabled(void);
+double mac_latency_now(void);
+
+// An input event came in (its event time; the main thread)
+void mac_latency_input(double event_time);
+
+// The VO thread: a frame starts being drawn. applied: the time of the input event whose effect
+// the frame shows (0 when nobody said)
+void mac_latency_frame_begin(double applied);
+// The frame is handed to the swapchain
+void mac_latency_frame_submitted(void);
+
+// The frame being drawn got its drawable (CAMetalLayer.nextDrawable): its id, for
+// mac_latency_presented, 0 when not logging
+uint64_t mac_latency_drawable(void);
+// The frame's drawable was shown at presented (0: it never was); any thread
+void mac_latency_presented(uint64_t id, double presented);
diff --git a/video/out/mac/metal_layer.swift b/video/out/mac/metal_layer.swift
index 5a321f164..faae4eb73 100644
--- a/video/out/mac/metal_layer.swift
+++ b/video/out/mac/metal_layer.swift
@@ -77,6 +77,19 @@ class MetalLayer: CAMetalLayer {
         if !Thread.isMainThread { CATransaction.flush() }
     }
 
+    // --macos-latency-log: when the frame drawn into this drawable was shown. MoltenVK takes the
+    // drawable while the frame is drawn (the VO thread)
+    override func nextDrawable() -> CAMetalDrawable? {
+        let drawable = super.nextDrawable()
+        if let drawable = drawable {
+            let id = mac_latency_drawable()
+            if id != 0 {
+                drawable.addPresentedHandler { shown in mac_latency_presented(id, shown.presentedTime) }
+            }
+        }
+        return drawable
+    }
+
     override var displaySyncEnabled: Bool {
         didSet {
             if displaySyncEnabled != oldValue { logState(property: "display sync") }
diff --git a/video/out/mac/view.swift b/video/out/mac/view.swift
index bf8c138e7..410c6146e 100644
--- a/video/out/mac/view.swift
+++ b/video/out/mac/view.swift
@@ -129,6 +129,7 @@ class View: NSView, CALayerDelegate {
     }
 
     override func mouseDragged(with event: NSEvent) {
+        mac_latency_input(event.timestamp)
         signalMouseMovement(event)
     }
 
@@ -176,8 +177,47 @@ class View: NSView, CALayerDelegate {
         case .cancelled: phase = "cancelled"
         default: if event.momentumPhase != [] { phase = "momentum" }
         }
+        sendGesture(kind, values, phase, event.timestamp)
+    }
+
+    // The event's time last (seconds of the host clock, as NSEvent.timestamp): a script passes it on in
+    // glsl-shader-opts as afp_input_time, for --macos-latency-log
+    func sendGesture(_ kind: String, _ values: [Double], _ phase: String, _ time: TimeInterval) {
+        mac_latency_input(time)
         let args = values.map { String(format: "%.4f", $0) }.joined(separator: " ")
-        input?.command("script-message gesture \(kind) \(args) \(phase)")
+        input?.command("script-message gesture \(kind) \(args) \(phase) \(String(format: "%.6f", time))")
+    }
+
+    // --macos-latency-test=<hz>: a two-finger scroll made up at that rate while the gestures are messages,
+    // a second to the right, a second to the left, timed when it's sent (no trackpad or HID in it)
+    var latencyTestTimer: Timer?
+    var latencyTestHz: Int = 0
+    var latencyTestCount: Int = 0
+
+    // Polled by MacCommon (the option can change at runtime) while the VO is there
+    func updateLatencyTest() {
+        let hz = Int(common.option.mac.macos_latency_test)
+        if hz == latencyTestHz { return }
+        stopLatencyTest()
+        latencyTestHz = hz
+        if hz <= 0 { return }
+        let timer = Timer(timeInterval: 1.0 / Double(hz), repeats: true) { [weak self] _ in self?.latencyTestTick() }
+        RunLoop.main.add(timer, forMode: .common)
+        latencyTestTimer = timer
+    }
+
+    func stopLatencyTest() {
+        latencyTestTimer?.invalidate()
+        latencyTestTimer = nil
+        latencyTestHz = 0
+        latencyTestCount = 0
+    }
+
+    func latencyTestTick() {
+        guard gestureMessages, latencyTestHz > 0 else { return }
+        let dx = (latencyTestCount / latencyTestHz) % 2 == 0 ? 4.0 : -4.0
+        latencyTestCount += 1
+        sendGesture("scroll", [dx, 0], "changed", CACurrentMediaTime())
     }
 
     override func magnify(with event: NSEvent) {
