diff --git a/video/out/mac/latency.c b/video/out/mac/latency.c
index 01e043950..2efb97b71 100644
--- a/video/out/mac/latency.c
+++ b/video/out/mac/latency.c
@@ -106,6 +106,21 @@ void mac_latency_frame_submitted(void)
     mp_mutex_unlock(&lock);
 }
 
+void mac_latency_frame_enqueued(void)
+{
+    double now = mac_latency_now();
+    mp_mutex_lock(&lock);
+    struct record *r = &ring[current.id % RING];
+    if (latency_log && current.id && r->id == current.id) {
+        mp_msg(latency_log, MSGL_INFO,
+               "frame=%" PRIu64 " applied=%.6f newest=%.6f begin=%.6f drawable=0.000000 "
+               "submit=%.6f shown=0.000000 fresh=%d sb=1\n", r->id, r->applied, r->newest,
+               r->begin, now, r->fresh);
+        r->id = 0;
+    }
+    mp_mutex_unlock(&lock);
+}
+
 uint64_t mac_latency_drawable(void)
 {
     double now = mac_latency_now();
diff --git a/video/out/mac/latency.h b/video/out/mac/latency.h
index c42323a10..35a0237ee 100644
--- a/video/out/mac/latency.h
+++ b/video/out/mac/latency.h
@@ -43,6 +43,9 @@ void mac_latency_frame_applied(double applied);
 void mac_latency_frame_fresh(bool fresh);
 // The frame is handed to the swapchain
 void mac_latency_frame_submitted(void);
+// The frame is enqueued to the sample buffer layer (--macos-sample-buffer-layer): logged now,
+// with shown=0 and sb=1, the layer saying nothing of when it shows it
+void mac_latency_frame_enqueued(void);
 
 // The frame being drawn got its drawable (CAMetalLayer.nextDrawable): its id, for
 // mac_latency_presented, 0 when not logging
diff --git a/video/out/mac/metal_layer.swift b/video/out/mac/metal_layer.swift
index faae4eb73..c84b97bac 100644
--- a/video/out/mac/metal_layer.swift
+++ b/video/out/mac/metal_layer.swift
@@ -90,9 +90,26 @@ class MetalLayer: CAMetalLayer {
         return drawable
     }
 
+    // What the swapchain sets (MoltenVK: off for VK_PRESENT_MODE_IMMEDIATE_KHR), unless
+    // --macos-display-sync turns it off
+    var displaySyncWanted: Bool = true
+    var displaySyncOff: Bool = false {
+        didSet { if displaySyncOff != oldValue { applyDisplaySync() } }
+    }
     override var displaySyncEnabled: Bool {
-        didSet {
-            if displaySyncEnabled != oldValue { logState(property: "display sync") }
+        get { return super.displaySyncEnabled }
+        set {
+            displaySyncWanted = newValue
+            applyDisplaySync()
+        }
+    }
+
+    func applyDisplaySync() {
+        let sync = displaySyncWanted && !displaySyncOff
+        if super.displaySyncEnabled != sync {
+            super.displaySyncEnabled = sync
+            logState(property: "display sync")
+            commitFromVoThread()
         }
     }
 
diff --git a/video/out/mac_common.swift b/video/out/mac_common.swift
index d521c90db..88bb281aa 100644
--- a/video/out/mac_common.swift
+++ b/video/out/mac_common.swift
@@ -155,6 +155,13 @@ class MacCommon: Common {
         }
     }
 
+    // --macos-display-sync: the frames shown as they come rather than at the next vsync (the VO thread)
+    @objc func updateDisplaySync(_ mode: Int32) {
+        let fullscreen = window?.isInFullscreen ?? false
+        let off = mode == MAC_DISPLAY_SYNC_NO || (mode == MAC_DISPLAY_SYNC_FULLSCREEN && !fullscreen)
+        if layer?.displaySyncOff != off { layer?.displaySyncOff = off }
+    }
+
     @objc func isVisible() -> Bool {
         return window?.occlusionState.contains(.visible) ?? false ||
                option.vo.force_render ||
