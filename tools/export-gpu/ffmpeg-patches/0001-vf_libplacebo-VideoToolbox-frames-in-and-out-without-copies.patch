+
+#ifndef AVFILTER_VF_LIBPLACEBO_VT_H
+#define AVFILTER_VF_LIBPLACEBO_VT_H
+
+#include <libplacebo/vulkan.h>
+#include <libplacebo/renderer.h>
+#include <libplacebo/utils/libav.h>
+
+/* VideoToolbox frames as libplacebo textures, through MoltenVK's VK_EXT_metal_objects */
+typedef struct FFPlVT FFPlVT;
+
+/* NULL where the Vulkan device can't import Metal textures */
+FFPlVT *ff_pl_vt_create(pl_vulkan vk);
+void ff_pl_vt_destroy(FFPlVT **vt);
+
+/* A biplanar IOSurface-backed frame (NV12, P010, P210...) as a pl_frame: its planes, its colors from the frame.
+ * `target`: rendered into. Returns 0 on failure */
+int ff_pl_vt_map(FFPlVT *vt, struct pl_frame *out, const AVFrame *frame, int target);
+
+/* Waits until the GPU is done with the frame's textures */
+void ff_pl_vt_unmap(FFPlVT *vt, struct pl_frame *frame);
+
+#endif /* AVFILTER_VF_LIBPLACEBO_VT_H */
diff --git a/libavfilter/vf_libplacebo_vt.m b/libavfilter/vf_libplacebo_vt.m
new file mode 100644
index 0000000..187a0c1
--- /dev/null
+++ b/libavfilter/vf_libplacebo_vt.m
@@ -0,0 +1,198 @@
+/*
+ * VideoToolbox frames in and out of the libplacebo filter without copies:
+ * each plane of a frame's IOSurface-backed CVPixelBuffer is an MTLTexture on
+ * that IOSurface, imported into Vulkan (MoltenVK, VK_EXT_metal_objects) and
+ * wrapped for libplacebo. Imports are kept per IOSurface: decoder and encoder
+ * pools recycle their buffers.
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#import <Metal/Metal.h>
+#import <CoreVideo/CoreVideo.h>
+#import <IOSurface/IOSurface.h>
+
+#define VK_USE_PLATFORM_METAL_EXT
+#include <vulkan/vulkan.h>
+
+#include "libavutil/frame.h"
+#include "libavutil/hwcontext.h"
+#include "vf_libplacebo_vt.h"
+
+#define MAX_IMPORTS 96
+
+typedef struct VTImport {
+    IOSurfaceID id;
+    int target;
+    int num_planes;
+    VkImage image[2];
+    pl_tex tex[2];
+    id<MTLTexture> mtl[2];
+    uint64_t used;
+} VTImport;
+
+struct FFPlVT {
+    pl_vulkan vk;
+    id<MTLDevice> device;
+    VTImport imports[MAX_IMPORTS];
+    int num_imports;
+    uint64_t clock;
+    PFN_vkCreateImage create_image;
+    PFN_vkDestroyImage destroy_image;
+};
+
+static void import_free(FFPlVT *vt, VTImport *im)
+{
+    for (int p = 0; p < im->num_planes; p++) {
+        pl_tex_destroy(vt->vk->gpu, &im->tex[p]);
+        if (im->image[p])
+            vt->destroy_image(vt->vk->device, im->image[p], NULL);
+        [im->mtl[p] release];
+    }
+    memset(im, 0, sizeof(*im));
+}
+
+FFPlVT *ff_pl_vt_create(pl_vulkan vk)
+{
+    int have = 0;
+    for (int i = 0; i < vk->num_extensions; i++)
+        have |= !strcmp(vk->extensions[i], VK_EXT_METAL_OBJECTS_EXTENSION_NAME);
+    if (!have)
+        return NULL;
+    PFN_vkExportMetalObjectsEXT export = (PFN_vkExportMetalObjectsEXT)
+        vk->get_proc_addr(vk->instance, "vkExportMetalObjectsEXT");
+    if (!export)
+        return NULL;
+    // The MTLDevice MoltenVK renders with: the textures are made on it
+    VkExportMetalDeviceInfoEXT dev = { .sType = VK_STRUCTURE_TYPE_EXPORT_METAL_DEVICE_INFO_EXT };
+    VkExportMetalObjectsInfoEXT objs = { .sType = VK_STRUCTURE_TYPE_EXPORT_METAL_OBJECTS_INFO_EXT, .pNext = &dev };
+    export(vk->device, &objs);
+    if (!dev.mtlDevice)
+        return NULL;
+    FFPlVT *vt = calloc(1, sizeof(*vt));
+    if (!vt)
+        return NULL;
+    vt->vk = vk;
+    vt->device = [dev.mtlDevice retain];
+    vt->create_image = (PFN_vkCreateImage) vk->get_proc_addr(vk->instance, "vkCreateImage");
+    vt->destroy_image = (PFN_vkDestroyImage) vk->get_proc_addr(vk->instance, "vkDestroyImage");
+    return vt;
+}
+
+void ff_pl_vt_destroy(FFPlVT **pvt)
+{
+    FFPlVT *vt = *pvt;
+    if (!vt)
+        return;
+    pl_gpu_finish(vt->vk->gpu);
+    for (int i = 0; i < vt->num_imports; i++)
+        import_free(vt, &vt->imports[i]);
+    [vt->device release];
+    free(vt);
+    *pvt = NULL;
+}
+
+static VTImport *import(FFPlVT *vt, CVPixelBufferRef pb, int target)
+{
+    IOSurfaceRef surf = CVPixelBufferGetIOSurface(pb);
+    if (!surf || !CVPixelBufferIsPlanar(pb) || CVPixelBufferGetPlaneCount(pb) != 2)
+        return NULL;
+    IOSurfaceID sid = IOSurfaceGetID(surf);
+    for (int i = 0; i < vt->num_imports; i++) {
+        if (vt->imports[i].id == sid && vt->imports[i].target == target) {
+            vt->imports[i].used = ++vt->clock;
+            return &vt->imports[i];
+        }
+    }
+    VTImport *im;
+    if (vt->num_imports < MAX_IMPORTS) {
+        im = &vt->imports[vt->num_imports++];
+    } else {
+        // The least recently used: every frame is done on the GPU before its buffer goes back (ff_pl_vt_unmap)
+        im = &vt->imports[0];
+        for (int i = 1; i < MAX_IMPORTS; i++)
+            if (vt->imports[i].used < im->used)
+                im = &vt->imports[i];
+        import_free(vt, im);
+    }
+    im->id = sid;
+    im->target = target;
+    im->used = ++vt->clock;
+    im->num_planes = 2;
+
+    // 8 or 16 bits a sample (NV12, NV16, P010, P210, P016...): the luma plane's bytes per pixel tell
+    int wide = CVPixelBufferGetBytesPerRowOfPlane(pb, 0) >= 2 * CVPixelBufferGetWidthOfPlane(pb, 0);
+    for (int p = 0; p < 2; p++) {
+        int w = (int) CVPixelBufferGetWidthOfPlane(pb, p), h = (int) CVPixelBufferGetHeightOfPlane(pb, p);
+        MTLPixelFormat mf = p ? (wide ? MTLPixelFormatRG16Unorm : MTLPixelFormatRG8Unorm)
+                              : (wide ? MTLPixelFormatR16Unorm : MTLPixelFormatR8Unorm);
+        VkFormat vf = p ? (wide ? VK_FORMAT_R16G16_UNORM : VK_FORMAT_R8G8_UNORM)
+                        : (wide ? VK_FORMAT_R16_UNORM : VK_FORMAT_R8_UNORM);
+        MTLTextureDescriptor *d = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:mf width:w height:h mipmapped:NO];
+        d.usage = MTLTextureUsageShaderRead | (target ? (MTLTextureUsageShaderWrite | MTLTextureUsageRenderTarget) : 0);
+        d.storageMode = MTLStorageModeShared;
+        im->mtl[p] = [vt->device newTextureWithDescriptor:d iosurface:surf plane:p];
+        if (!im->mtl[p])
+            goto fail;
+        VkImageUsageFlags usage = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+        if (target)
+            usage |= VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+        VkImportMetalTextureInfoEXT imp = { .sType = VK_STRUCTURE_TYPE_IMPORT_METAL_TEXTURE_INFO_EXT,
+                                            .plane = VK_IMAGE_ASPECT_PLANE_0_BIT, .mtlTexture = im->mtl[p] };
+        VkImageCreateInfo ci = { .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO, .pNext = &imp, .imageType = VK_IMAGE_TYPE_2D,
+                                 .format = vf, .extent = { w, h, 1 }, .mipLevels = 1, .arrayLayers = 1,
+                                 .samples = VK_SAMPLE_COUNT_1_BIT, .tiling = VK_IMAGE_TILING_OPTIMAL, .usage = usage,
+                                 .sharingMode = VK_SHARING_MODE_EXCLUSIVE, .initialLayout = VK_IMAGE_LAYOUT_UNDEFINED };
+        if (vt->create_image(vt->vk->device, &ci, NULL, &im->image[p]) != VK_SUCCESS)
+            goto fail;
+        im->tex[p] = pl_vulkan_wrap(vt->vk->gpu, pl_vulkan_wrap_params(.image = im->image[p], .width = w, .height = h,
+                                                                       .format = vf, .usage = usage));
+        if (!im->tex[p])
+            goto fail;
+        // libplacebo's from now on; MoltenVK moves no pixels on a layout change
+        pl_vulkan_release_ex(vt->vk->gpu, pl_vulkan_release_params(.tex = im->tex[p], .layout = VK_IMAGE_LAYOUT_GENERAL,
+                                                                   .qf = VK_QUEUE_FAMILY_IGNORED));
+    }
+    return im;
+
+fail:
+    import_free(vt, im);
+    return NULL;
+}
+
+int ff_pl_vt_map(FFPlVT *vt, struct pl_frame *out, const AVFrame *frame, int target)
+{
+    CVPixelBufferRef pb = (CVPixelBufferRef) frame->data[3];
+    VTImport *im = pb ? import(vt, pb, target) : NULL;
+    if (!im)
+        return 0;
+    pl_frame_from_avframe(out, frame);
+    if (out->num_planes != 2)
+        return 0;
+    for (int p = 0; p < 2; p++)
+        out->planes[p].texture = im->tex[p];
+    return 1;
+}
+
+void ff_pl_vt_unmap(FFPlVT *vt, struct pl_frame *frame)
+{
+    // Done on the GPU before the buffer goes back to its pool, or on to the encoder
+    pl_gpu_flush(vt->vk->gpu);
+    for (int p = 0; p < frame->num_planes; p++)
+        while (frame->planes[p].texture && pl_tex_poll(vt->vk->gpu, frame->planes[p].texture, UINT64_MAX))
+            ;
+}
