--- a/libavfilter/vf_libplacebo.c
+++ b/libavfilter/vf_libplacebo.c
@@ -1592,6 +1592,9 @@ static int libplacebo_config_output(AVFilterLink *outlink)
         vtfc->sw_format = s->out_format;
