{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ActionFootageLibrary",
  "version": "0.1.0",
  "identifier": "io.github.anton-belkin.action-footage-library",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Action Footage Library",
        "width": 780,
        "height": 680,
        "minWidth": 560,
        "minHeight": 440
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
